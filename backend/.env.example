# AI/ML API (https://aimlapi.com) — OpenAI-compatible endpoint
AIML_API_KEY=your_aimlapi_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini

# --- To use Groq instead (e.g. openai/gpt-oss-120b) ---
# Groq is OpenAI-compatible and needs no code changes, just swap these:
# AIML_API_KEY=your_groq_api_key_here
# AIML_BASE_URL=https://api.groq.com/openai/v1
# AIML_MODEL=openai/gpt-oss-120b
# Other Groq model IDs: openai/gpt-oss-20b, llama-3.3-70b-versatile,
# qwen/qwen3-32b — see https://console.groq.com/docs/models

# Clerk auth (optional — leave CLERK_AUTH_ENABLED=false for local dev without auth)
CLERK_AUTH_ENABLED=false
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Processing limits
MAX_FILE_SIZE_MB=20
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=8
LLM_CONCURRENCY=2
# LLM_REQUESTS_PER_MINUTE bounds actual request RATE, not just how many
# calls are in flight at once. LLM_CONCURRENCY alone won't stop you from
# tripping 429s: if each call returns in ~1s, a concurrency of 5 can
# still fire 300 requests/minute. Set this to your provider's real RPM
# limit (check their dashboard) minus a small safety margin, e.g. if
# your plan allows 20 RPM, set this to 15-18. 0 disables the limiter.
LLM_REQUESTS_PER_MINUTE=15
# If you're on a free/low tier, its per-minute request/token limits are
# tight — the two settings above (low concurrency + a real RPM cap) are
# what actually keep you under them; the retry logic just cleans up
# whatever still slips through.
