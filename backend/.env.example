# AI/ML API (https://aimlapi.com) — OpenAI-compatible endpoint
AIML_API_KEY=your_aimlapi_key_here
AIML_BASE_URL=https://api.aimlapi.com/v1
AIML_MODEL=gpt-4o-mini

# --- To use Groq instead (e.g. openai/gpt-oss-120b) ---
# Groq is OpenAI-compatible and needs no code changes, just swap these:
# AIML_API_KEY=your_groq_api_key_here
# AIML_BASE_URL=https://api.groq.com/openai/v1
# AIML_MODEL=openai/gpt-oss-120b
# Other Groq model IDs: openai/gpt-oss-20b, llama-3.3-70b-versatile,
# qwen/qwen3-32b — see https://console.groq.com/docs/models

# Clerk auth (optional — leave CLERK_AUTH_ENABLED=false for local dev without auth)
CLERK_AUTH_ENABLED=false
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Processing limits
MAX_FILE_SIZE_MB=20
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=8

# --- Phase 1 / "just make it stop 429ing" setup: a true sequential queue ---
# LLM_CONCURRENCY=1 makes paragraphs process strictly one at a time.
# LLM_REQUEST_DELAY_SECONDS adds a guaranteed pause after each successful
# call before the next one is allowed to start (held while still holding
# the concurrency slot) — so together these two give you a genuine
# one-at-a-time queue with a fixed gap between requests, not just a cap
# on simultaneous calls. Slow, but the simplest thing that reliably stays
# under a small/free-tier rate limit. Tune the delay to your plan (e.g.
# 15 RPM allowed -> 60/15 = 4s minimum gap; add a little margin -> ~5s).
LLM_CONCURRENCY=1
LLM_REQUEST_DELAY_SECONDS=5

# --- Phase 2 / more throughput once you trust your limits ---
# Raise LLM_CONCURRENCY back up and drop LLM_REQUEST_DELAY_SECONDS to 0,
# and instead use LLM_REQUESTS_PER_MINUTE as a real RPM budget shared
# across concurrent calls (0 disables it). Set it to your provider's
# actual RPM limit (check their dashboard) minus a safety margin.
# LLM_CONCURRENCY=5
# LLM_REQUEST_DELAY_SECONDS=0
# LLM_REQUESTS_PER_MINUTE=15
LLM_REQUESTS_PER_MINUTE=0

